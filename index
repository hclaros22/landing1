<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Rio Portuguese Water Dogs</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #17324d;
      background: #f7fbff;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
    }

    /* TOP BANNER */
    .hero-banner {
      position: relative;
      width: 100%;
      height: 600px;
      overflow: hidden;
    }

    .hero-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-text {
      position: absolute;
      top: 50%;
      left: 8%;
      transform: translateY(-50%);
      max-width: 620px;
      color: #15395b;
      background: rgba(255, 255, 255, 0.55);
      padding: 28px 34px;
      border-radius: 24px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    }

    .hero-text h1 {
      font-size: clamp(42px, 6vw, 76px);
      line-height: 0.98;
      margin-bottom: 12px;
      color: #15395b;
    }

    .hero-text h2 {
      font-size: clamp(32px, 4vw, 52px);
      font-style: italic;
      color: #111;
      margin-bottom: 14px;
    }

    .hero-text p {
      font-size: 20px;
      color: #234b6d;
      margin-bottom: 22px;
    }

    /* BUTTONS */
    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-block;
      padding: 15px 24px;
      border-radius: 999px;
      font-weight: 700;
      color: white;
      box-shadow: 0 8px 20px rgba(0,0,0,.15);
      transition: transform 0.2s ease, opacity 0.2s ease;
      text-align: center;
    }

    .btn:hover {
      transform: translateY(-2px);
      opacity: 0.92;
    }

    .btn-blue {
      background: #15395b;
    }

    .btn-pink {
      background: #d62976;
    }

    .btn-green {
      background: #25D366;
    }

    .btn-light {
      background: #2d92b8;
    }

    section {
      padding: 70px 7%;
    }

    .center {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 42px;
    }

    .center h2 {
      font-size: 42px;
      color: #15395b;
      margin-bottom: 10px;
    }

    .center p {
      font-size: 18px;
      color: #516b7f;
    }

    /* PUPPY GRID */
    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      max-width: 1180px;
      margin: 0 auto;
    }

    .card {
      background: white;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 12px 30px rgba(23,50,77,.12);
      text-align: center;
    }

    .card img {
      width: 100%;
      height: 260px;
      object-fit: cover;
      display: block;
    }

    .card h3 {
      font-size: 22px;
      padding: 16px 10px 2px;
      color: #15395b;
    }

    .gender {
      font-size: 16px;
      font-weight: 700;
      color: #2d789c;
      margin-bottom: 8px;
    }

    .tag {
      display: inline-block;
      margin-bottom: 18px;
      padding: 6px 14px;
      border-radius: 999px;
      background: #e8f6fb;
      color: #2d789c;
      font-weight: 700;
      font-size: 14px;
    }

    /* INFO SECTIONS */
    .info {
      background: white;
    }

    .two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .panel {
      background: #f0f8fc;
      padding: 34px;
      border-radius: 24px;
      box-shadow: 0 10px 24px rgba(23,50,77,.08);
    }

    .panel h2 {
      font-size: 32px;
      color: #15395b;
      margin-bottom: 15px;
    }

    .panel ul {
      list-style: none;
    }

    .panel li {
      padding: 8px 0;
      font-size: 18px;
    }

    /* FEATURES */
    .features {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 20px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .feature {
      background: white;
      padding: 26px;
      border-radius: 22px;
      text-align: center;
      box-shadow: 0 12px 28px rgba(23,50,77,.10);
    }

    .feature div {
      font-size: 36px;
      margin-bottom: 10px;
    }

    .feature h3 {
      color: #15395b;
      margin-bottom: 8px;
    }

    /* CTA */
    .cta {
      background: #15395b;
      color: white;
      text-align: center;
    }

    .cta h2 {
      font-size: 40px;
      margin-bottom: 12px;
    }

    .cta p {
      font-size: 20px;
      margin-bottom: 26px;
      color: #d9ecf5;
    }

    footer {
      text-align: center;
      padding: 28px;
      background: #0e2943;
      color: #d7e9f3;
    }

    /* MOBILE */
    @media (max-width: 900px) {
      .hero-banner {
        height: 560px;
      }

      .hero-text {
        left: 5%;
        right: 5%;
        max-width: none;
        padding: 24px;
      }

      .grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .two,
      .features {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      section {
        padding: 52px 5%;
      }

      .hero-banner {
        height: 520px;
      }

      .hero-text {
        top: 48%;
      }

      .hero-text h1 {
        font-size: 40px;
      }

      .hero-text h2 {
        font-size: 32px;
      }

      .hero-text p {
        font-size: 17px;
      }

      .grid {
        grid-template-columns: 1fr;
      }

      .card img {
        height: 330px;
      }

      .buttons {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <!-- TOP BANNER -->
